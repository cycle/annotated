{
    "name": "cycle/annotated",
    "type": "library",
    "license": "MIT",
    "description": "Cycle ORM Annotated Entities generator",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "homepage": "https://cycle-orm.dev",
    "support": {
        "issues": "https://github.com/cycle/annotated/issues",
        "source": "https://github.com/cycle/annotated",
        "docs": "https://cycle-orm.dev/docs",
        "chat": "https://discord.gg/spiralphp"
    },
    "authors": [
        {
            "name": "Anton Titov (wolfy-j)",
            "email": "wolfy-j@spiralscout.com"
        },
        {
            "name": "Aleksei Gagarin",
            "homepage": "https://github.com/roxblnfk"
        },
        {
            "name": "Pavel Butchnev",
            "homepage": "https://github.com/butschster"
        },
        {
            "name": "Maksim Smakouz (msmakouz)",
            "email": "maksim.smakouz@spiralscout.com"
        }
    ],
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/cycle"
        }
    ],
    "require": {
        "php": ">=8.2",
        "cycle/database": "^2.23",
        "cycle/orm": "^2.18",
        "cycle/schema-builder": "^2.12",
        "spiral/attributes": "^3.1",
        "spiral/tokenizer": "^3.17",
        "doctrine/inflector": "^2.1"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.8",
        "buggregator/trap": "^1.20",
        "cycle/testing": "^0.1.1",
        "doctrine/annotations": "^2.0.2",
        "llm/skills": "^1.20",
        "roxblnfk/unpoly": "^1.8",
        "testo/testo": "^0.10.60"
    },
    "suggest": {
        "llm/skills": "To sync the cycle-orm-attributes AI skill into your project"
    },
    "autoload": {
        "psr-4": {
            "Cycle\\Annotated\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cycle\\Annotated\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "cs:diff": "php-cs-fixer fix --dry-run -v --diff --config=vendor-bin/code-style/.php-cs-fixer.dist.php",
        "cs:fix": "php-cs-fixer fix -v --config=vendor-bin/code-style/.php-cs-fixer.dist.php",
        "infect": [
            "Composer\\Config::disableProcessTimeout",
            "@putenv XDEBUG_MODE=coverage",
            "@putenv DB_DRIVERS=sqlite",
            "infection --configuration=infection.json --threads=max"
        ],
        "infect:ci": [
            "Composer\\Config::disableProcessTimeout",
            "@putenv XDEBUG_MODE=coverage",
            "@putenv DB_DRIVERS=sqlite",
            "infection --ansi --configuration=infection.json --logger-github --threads=max --show-mutations=0"
        ],
        "psalm": "psalm -c vendor-bin/psalm/psalm.xml",
        "psalm:baseline": "psalm -c vendor-bin/psalm/psalm.xml --set-baseline=vendor-bin/psalm/psalm-baseline.xml",
        "psalm:ci": "psalm -c vendor-bin/psalm/psalm.xml --output-format=github --shepherd --show-info=false --stats --threads=4",
        "db:down": "docker compose -f vendor/cycle/testing/resources/docker/compose.yaml down -v",
        "db:up": "docker compose -f vendor/cycle/testing/resources/docker/compose.yaml up -d --wait",
        "test": "testo",
        "test:mysql": "testo --suite=Feature/MySQL --suite=Acceptance/MySQL --suite=Regression/MySQL",
        "test:new-case": "cycle-testing new-case --template=orm-attributes",
        "test:postgres": "testo --suite=Feature/Postgres --suite=Acceptance/Postgres --suite=Regression/Postgres",
        "test:sqlite": "testo --suite=Feature/SQLite --suite=Acceptance/SQLite --suite=Regression/SQLite",
        "test:sqlserver": "testo --suite=Feature/SQLServer --suite=Acceptance/SQLServer --suite=Regression/SQLServer",
        "test:unit": "testo --suite=Unit"
    },
    "scripts-descriptions": {
        "infect": "Run mutation testing with Infection on the Unit and SQLite suites",
        "infect:ci": "Run mutation testing in CI, failing below the minimum MSI",
        "test:new-case": "Create a regression case for an issue: composer test:new-case -- <issue>"
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": true,
            "forward-command": false,
            "target-directory": "vendor-bin"
        },
        "skills": {
            "sources": [
                {
                    "from": "github",
                    "package": "cycle/skills",
                    "skills": [
                        "cycle-orm-attributes"
                    ]
                }
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true,
            "llm/skills": true
        },
        "audit": {
            "abandoned": "report"
        }
    }
}
